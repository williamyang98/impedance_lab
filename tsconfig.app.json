{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": [
    "env.d.ts",
    "src/**/*",
    "src/**/*.vue",
    "test/**/*",
    "docs/.vitepress/theme/*",
  ],
  "exclude": [
    "src/**/__tests__/*",
    "src/wasm/vendor/**"
  ],
  "compilerOptions": {
    "strict": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "paths": {
    },
    "target": "es2024",
    "module": "es2022",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["@webgpu/types", "vite/client"],
    "noImplicitReturns": true
  }
}
